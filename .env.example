# Copie este arquivo para .env se quiser usar variáveis de ambiente
# (o .env é ignorado pelo Git). Rode com: node --env-file=.env src/index.js

# Caminho do arquivo de credenciais (padrão: ./serviceAccountKey.json)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Alternativa: colar o JSON da service account inteiro em uma linha
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Usado apenas se você rodar contra o emulador do Firestore
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-alunos
